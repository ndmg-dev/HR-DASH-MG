HR_ENVIRONMENT=development
HR_APP_TITLE="Mendonça Galvão HR Analytics"

# Legado — não é mais usado após a migração para SSO do CRM (ver backend/app/auth.py)
HR_CONFIDENTIAL_PASSWORD="senha_segura_123"

# ── SSO com o CRM_MG ─────────────────────────────────────────────────────
# OBRIGATÓRIO em produção: deve ser IDÊNTICO ao JWT_SECRET do backend-fastapi
# do CRM. Sem ele, toda chamada /api/* é recusada com 401.
HR_CRM_JWT_SECRET=""
# E-mails autorizados na Área Restrita (detalhamento nominal), separados por
# vírgula. Vazio = qualquer usuário autenticado pelo CRM pode ver.
HR_CONFIDENTIAL_ALLOWLIST=""
# Domínios de e-mail aceitos no SSO (separados por vírgula).
HR_ALLOWED_EMAIL_DOMAINS="mendoncagalvao.com.br,nucleodigital.cloud"
